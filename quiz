
questions = [
    {
        "question": "Which keyword is used to define a function in Python?",
        "options": {
            "A": "function",
            "B": "def",
            "C": "define",
            "D": "fun"
        },
        "answer": "B"
    },
    {
        "question": "Which data type stores key-value pairs?",
        "options": {
            "A": "List",
            "B": "Tuple",
            "C": "Dictionary",
            "D": "Set"
        },
        "answer": "C"
    },
    {
        "question": "Which symbol is used for comments in Python?",
        "options": {
            "A": "//",
            "B": "/*",
            "C": "#",
            "D": "@"
        },
        "answer": "C"
    },
    {
        "question": "Which method adds an item to a list?",
        "options": {
            "A": "add()",
            "B": "append()",
            "C": "insert_end()",
            "D": "push()"
        },
        "answer": "B"
    },
    {
        "question": "Which loop is used to iterate over a sequence?",
        "options": {
            "A": "if",
            "B": "switch",
            "C": "for",
            "D": "def"
        },
        "answer": "C"
    }
]


def show_instructions():
    print("\n===== QUIZ INSTRUCTIONS =====")
    print("1. The quiz contains 5 questions.")
    print("2. Each question has four options: A, B, C, D.")
    print("3. Enter the letter of your answer.")
    print("4. Each correct answer earns 1 point.")
    print("5. Incorrect answers earn 0 points.")
    print("6. Invalid choices will not be counted.")
    print("7. Try to get the highest score!")


def start_quiz():
    score = 0
    correct = 0
    incorrect = 0
    total = len(questions)

    print("\n===== QUIZ STARTED =====")

    for i, q in enumerate(questions, start=1):
        print(f"\nQuestion {i}: {q['question']}")

        for option, value in q["options"].items():
            print(f"{option}. {value}")

        while True:
            try:
                answer = input("Enter your answer (A/B/C/D): ")
                answer = answer.strip().upper()

                if answer not in ["A", "B", "C", "D"]:
                    print("Invalid choice! Enter A, B, C, or D.")
                    continue

                break

            except (EOFError, KeyboardInterrupt):
                print("\nInput interrupted. Returning to menu.")
                return

        if answer == q["answer"]:
            print("Correct answer!")
            score += 1
            correct += 1

        else:
            print(f"Incorrect! Correct answer: {q['answer']}. "
                  f"{q['options'][q['answer']]}")
            incorrect += 1

    percentage = (score / total) * 100 if total > 0 else 0

    print("\n===== QUIZ RESULTS =====")
    print(f"Total Questions : {total}")
    print(f"Correct Answers : {correct}")
    print(f"Incorrect Answers: {incorrect}")
    print(f"Final Score     : {percentage:.0f}%")

    if percentage == 100:
        print("Performance: Excellent! Perfect score!")
    elif percentage >= 80:
        print("Performance: Great job!")
    elif percentage >= 60:
        print("Performance: Good job!")
    elif percentage >= 40:
        print("Performance: Keep practising!")
    else:
        print("Performance: Don't give up! Try again.")


def main():
    while True:
        print("\n===== QUIZ APPLICATION =====")
        print("1. Start Quiz")
        print("2. View Quiz Instructions")
        print("3. Exit")

        try:
            choice = input("Enter your choice: ").strip()

            if choice == "1":
                start_quiz()

                while True:
                    replay = input(
                        "\nWould you like to play again? (yes/no): "
                    ).strip().lower()

                    if replay in ["yes", "y"]:
                        break
                    elif replay in ["no", "n"]:
                        print("Returning to main menu.")
                        break
                    else:
                        print("Invalid choice! Enter yes or no.")

            elif choice == "2":
                show_instructions()

            elif choice == "3":
                print("Thank you for using the Quiz Application!")
                print("Goodbye!")
                break

            else:
                print("Invalid menu choice! Enter 1, 2, or 3.")

        except (EOFError, KeyboardInterrupt):
            print("\nApplication closed safely.")
            break


if __name__ == "__main__":
    main()
